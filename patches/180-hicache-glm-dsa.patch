+class DSAIndexerHostPoolBuilder:
+    def validate(
+        self,
+        *,
+        decl: HostPoolDecl,
+        page_size: int,
+        packed_draft_device_pools: tuple[DSATokenToKVPool, ...],
+    ) -> None:
+        target = decl.device_pool
