+    def _ax_decode_rounds_owed(self, batch: ScheduleBatch, running_batch: Optional[ScheduleBatch]) -> int:
+        # [ax] 122: decode rounds owed to the streams that keep generating while this prefill batch runs, so that
+        # their TPOT stays near the target: estimated prefill time / (target - one decode step), capped. Nothing is
+        # owed when no request is decoding, so a lone cold prefill is never delayed.
+        params = _ax_tpot_params()
+        if params is None or running_batch is None or running_batch.is_prefill_only:
+            return 0
+        if not any(not req.finished() for req in running_batch.reqs):
+            return 0
+        target, fixed, per_token, step, max_rounds = params
+        new_tokens = getattr(batch, "extend_num_tokens", None)
+        if new_tokens is None:
+            new_tokens = sum(getattr(req, "extend_input_len", 0) or 0 for req in batch.reqs)
+        estimate = fixed + per_token * new_tokens
+        return max(1, min(max_rounds, math.ceil(estimate / max(target - step, 0.005))))
 
