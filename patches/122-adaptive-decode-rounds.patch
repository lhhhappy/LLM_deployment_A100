+def _ax_tpot_params():
+    """[ax] 122: adaptive decode rounds after each prefill batch; None when off.
+
+    SGLANG_AX_TPOT_TARGET (seconds per token, default 0 = off) enables it. Prefill time is estimated as
+    SGLANG_AX_PREFILL_FIXED_S + SGLANG_AX_PREFILL_PER_TOKEN_S * new tokens (defaults 0.11 s and 65 us/token: 8-card
+    TP8 measurements F87/F88), one decode round as SGLANG_AX_DECODE_STEP_S (0.022 s); at most
+    SGLANG_AX_DECODE_ROUNDS_MAX (64) rounds per prefill batch.
+    """
+    target = float(os.environ.get("SGLANG_AX_TPOT_TARGET", "0") or 0)
+    if target <= 0:
+        return None
+    return (
+        target,
+        float(os.environ.get("SGLANG_AX_PREFILL_FIXED_S", "0.11")),
+        float(os.environ.get("SGLANG_AX_PREFILL_PER_TOKEN_S", "0.000065")),
+        float(os.environ.get("SGLANG_AX_DECODE_STEP_S", "0.022")),
+        int(os.environ.get("SGLANG_AX_DECODE_ROUNDS_MAX", "64")),
+    )
+
