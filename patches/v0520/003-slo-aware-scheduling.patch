@@ -0,0 +1,112 @@
+"""Opt-in SLO queue ordering, using server-observed session/cache information.
+
+No evaluator labels, timestamps or output budgets are modified. The inference
+is deliberately conservative: later session requests get 3/5s, since headers
+alone cannot distinguish turn starts or context reconstruction. TP single-DP
+is the supported draft topology; session tracking is local to each scheduler.
+"""
+from collections import OrderedDict
+import math
+import os
+import time
+
+SLO_POLICIES = ('arena-edf', 'arena-least-slack', 'arena-edf-chain-weighted')
+
+
+def apply_slo_headers(obj, request):
+    # Override these internal scheduling hints from the real request, never a
+    # client-provided timestamp. D0 supplies the earlier pre-body ASGI stamp.
+    obj.arena_slo_session = request.headers.get('x-s1-session-id') or None
+    obj.arena_slo_namespace = request.headers.get('x-s1-cache-namespace') or ''
+    obj.arena_slo_arrival = request.scope.get('arena_recv_perf')
+    if obj.arena_slo_arrival is None:
+        obj.arena_slo_arrival = time.perf_counter()
+
+
+class SloPolicy:
+    def __init__(self, policy):
+        if policy not in SLO_POLICIES:
+            raise ValueError('unknown SLO policy')
+        self.policy = policy
+        self.sessions = OrderedDict()
+        self.session_cap = 65536
+        self.chain_weight = self._setting('CHAIN_WEIGHT', 2.0, 1.0)
+        self.prefill_tps = self._setting('PREFILL_TPS', 40000.0, 1.0)
+        self.length_alpha = self._setting('LENGTH_ALPHA', 1.2, 0.0)
+        self.overhead_s = self._setting('OVERHEAD_S', 0.002, 0.0)
+
+    @staticmethod
+    def _setting(name, default, minimum):
+        value = float(os.environ.get('SGLANG_ARENA_SLO_' + name, default))
+        if not math.isfinite(value) or value < minimum:
+            raise ValueError('invalid SGLANG_ARENA_SLO_' + name)
+        return value
+
+    def register(self, req, recv_req):
+        # Once per new request; retries/retractions retain the original deadline.
+        if hasattr(req, '_arena_slo_arrival'):
+            return
+        sid = getattr(recv_req, 'arena_slo_session', None)
+        namespace = getattr(recv_req, 'arena_slo_namespace', None) or ''
+        key = (namespace, sid)
+        req._arena_slo_chain_start = bool(sid) and key not in self.sessions
+        if sid:
+            self.sessions[key] = None
+            self.sessions.move_to_end(key)
+            if len(self.sessions) > self.session_cap:
+                self.sessions.popitem(last=False)
+        arrival = getattr(recv_req, 'arena_slo_arrival', None)
+        # Non-HTTP callers lack the trusted header stamp. Use scheduler arrival
+        # for ordering only, without replacing any measured time_stats field.
+        req._arena_slo_arrival = arrival if arrival is not None else time.perf_counter()
+
+    @staticmethod
+    def work(req):
+        return max(1, len(req.origin_input_ids) + len(req.output_ids)
+                   - req.num_matched_prefix_tokens)
+
+    def prepare(self, req):
+        if not hasattr(req, '_arena_slo_deadline'):
+            # Direct/internal Req producers may bypass register; conservatively
+            # use intra. Freeze the inferred bucket before partial progress.
+            arrival = getattr(req, '_arena_slo_arrival', req.time_stats.wait_queue_entry_time)
+            cold = getattr(req, '_arena_slo_chain_start', False)
+            limit = 30.0 if cold else (3.0 if self.work(req) <= 4096 else 5.0)
+            weight = self.chain_weight if cold and self.policy == 'arena-edf-chain-weighted' else 1.0
+            req._arena_slo_arrival = arrival
+            req._arena_slo_limit = limit
+            req._arena_slo_deadline = arrival + limit
+            req._arena_slo_scheduling_deadline = arrival + limit * weight
+
+    def key(self, req, now, remaining=None):
+        self.prepare(req)
+        service = 0.0
+        if self.policy == 'arena-least-slack':
+            work = self.work(req) if remaining is None else remaining
+            prompt = len(req.origin_input_ids) + len(req.output_ids)
+            service = (work * max(1.0, prompt / 32768) ** self.length_alpha
+                       / self.prefill_tps + self.overhead_s)
+        return (req._arena_slo_scheduling_deadline - now - service, req._arena_slo_arrival)
+
+    def sort(self, waiting):
+        now = time.perf_counter()
+        # Stable ties. Prefix matching still runs; duplicate-prefix preference
+        # may not override an earlier deadline indefinitely in this policy.
+        waiting.sort(key=lambda req: self.key(req, now))
+
+    def chunk_limit(self, active, waiting, budget, page, align):
+        if budget < align + page:
+            return None
+        now = time.perf_counter()
+        remaining = len(active.full_untruncated_fill_ids) - len(active.prefix_indices)
+        active_key = self.key(active, now, remaining)
+        reserved = 0
+        for req in waiting:
+            work = self.work(req)
+            charge = math.ceil(work / page) * page
+            # Reserve only full, more urgent waiters, preserving the one-partial
+            # authority in PrefillAdder and one aligned unit of active progress.
+            if self.key(req, now) >= active_key or reserved + charge > budget - align:
+                break
+            reserved += charge
+        return (budget - reserved) // align * align if reserved else None
