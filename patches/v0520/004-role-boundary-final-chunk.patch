+    def _role_boundary_final_chunk_len(
+        self, req: Req, prefix_len: int, extend_len: int
+    ) -> Optional[int]:
+        """[arena D1 v1.2] Length to prefill in the final chunk so that it ends at
+        the last role boundary (grid-aligned, relative to the chunk start), or
+        None to keep the stock final chunk. Same eligibility rules as the
+        admission-time split (_maybe_role_boundary_split)."""
+        boundary_ids = _role_boundary_token_ids()
+        if not boundary_ids:
+            return None
+        stats = ROLE_BOUNDARY_STATS
+        if self.rem_chunk_tokens is None:
+            return None
+        if not getattr(self.tree_cache, "supports_mamba", lambda: False)():
+            return None
+        full_len = prefix_len + extend_len
+        branch = getattr(req, "mamba_branching_seqlen", None)
+        if branch is not None and prefix_len < branch <= full_len:
+            stats["tail_skipped_branch_conflict"] += 1
+            return None
+        grid = mamba_checkpoint_grid(self.tree_cache.page_size)
+        align = getattr(self, "_arena_truncation_align", None) or 1
+        grid = grid * align // math.gcd(grid, align)
+        if prefix_len % grid != 0:
+            stats["tail_skipped_unaligned_prefix"] += 1
+            return None
+        ids = req.full_untruncated_fill_ids
+        lo = max(prefix_len, full_len - _ROLE_BOUNDARY_SCAN_WINDOW)
+        pos = -1
+        for i in range(full_len - 1, lo - 1, -1):
+            if ids[i] in boundary_ids:
+                pos = i
+                break
+        if pos < 0:
+            stats["tail_skipped_no_boundary"] += 1
+            return None
+        split_len = (pos - prefix_len) // grid * grid
+        end_aligned_len = extend_len // grid * grid
+        if split_len < grid or split_len >= end_aligned_len:
+            stats["tail_skipped_short"] += 1
+            return None
+        stats["tail_taken"] += 1
+        return split_len
+
