+    def _maybe_role_boundary_split(
+        self, req: Req, admission: _PrefillAdmission, has_chunked_req: bool
+    ) -> Optional[_PrefillAdmission]:
+        """[arena D1, policy role_conservative] Return a shortened admission that
+        ends at the last role-boundary token (floored to the mamba checkpoint
+        grid), or None to keep stock behaviour. Never changes the request's
+        sampling budget; only this partial-prefill admission is shortened."""
+        boundary_ids = _role_boundary_token_ids()
+        if not boundary_ids:
+            return None
+        stats = ROLE_BOUNDARY_STATS
+        if self.dllm_config is not None or admission.is_chunked:
+            stats["skipped_already_chunked"] += 1
+            return None
+        if has_chunked_req or self.new_chunked_req is not None:
+            stats["skipped_active_chunk"] += 1
+            return None
+        if self.rem_chunk_tokens is None:
+            # Chunked prefill disabled: add_chunked_req would do min(None, int).
+            stats["skipped_no_chunked_prefill"] += 1
+            return None
+        if not getattr(self.tree_cache, "supports_mamba", lambda: False)():
+            return None
+        prefix_len = admission.prefix_len
+        full_len = prefix_len + admission.extend_len
+        branch = getattr(req, "mamba_branching_seqlen", None)
+        if branch is not None and branch > prefix_len:
+            # Conservative: the branch point owns this forward's single track.
+            stats["skipped_branch_conflict"] += 1
+            return None
+        # Same grid as schedule_batch._mamba_radix_cache_v2_req_prepare_for_extend.
+        grid = mamba_checkpoint_grid(self.tree_cache.page_size)
+        align = getattr(self, "_arena_truncation_align", None) or 1
+        grid = grid * align // math.gcd(grid, align)
+        if prefix_len % grid != 0:
+            stats["skipped_unaligned_prefix"] += 1
+            return None
+        ids = req.full_untruncated_fill_ids
+        # The next turn diverges near the tail; bound the reverse scan.
+        lo = max(prefix_len, full_len - _ROLE_BOUNDARY_SCAN_WINDOW)
+        pos = -1
+        for i in range(full_len - 1, lo - 1, -1):
+            if ids[i] in boundary_ids:
+                pos = i
+                break
+        if pos < 0:
+            stats["skipped_no_boundary"] += 1
+            return None
+        # Track position must be grid-aligned relative to the extend start.
+        split_len = (pos - prefix_len) // grid * grid
+        end_aligned_len = (full_len - prefix_len) // grid * grid
+        if split_len < grid or split_len >= end_aligned_len:
+            # Too short, or would coincide with the stock end checkpoint.
+            stats["skipped_short"] += 1
+            return None
+        stats["taken"] += 1
+        return _PrefillAdmission(prefix_len, split_len, 0, True)
