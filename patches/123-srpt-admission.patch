     @staticmethod
+    def _ax_sort_by_remaining_work(
+        waiting_queue: List[Req], temporary_deprioritized: Set[int]
+    ) -> None:
+        # [ax] 123: shortest remaining prefill first. A cache hit shortens the remaining work, so cheap hits still go
+        # first as under LPM; among cold requests the small ones no longer wait behind large ones. Aging adds
+        # SGLANG_AX_SRPT_AGING tokens of priority per second waited, so long requests are not starved. Requests held
+        # back for in-batch prefix sharing stay last, as under LPM.
+        aging = _ax_srpt_aging()
+        now = time.perf_counter()
+
+        def key(r):
+            if r.rid in temporary_deprioritized:
+                return (1, 0.0)
+            remaining = len(r.origin_input_ids) + len(r.output_ids) - r.num_matched_prefix_tokens
+            entered = r.time_stats.wait_queue_entry_time or now
+            return (0, remaining - aging * max(0.0, now - entered))
+
+        waiting_queue.sort(key=key)
