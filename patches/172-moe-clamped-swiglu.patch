+@triton.jit
+def _ax172_clamped_swiglu(
+    x, out, elements, stride_x, stride_out,
+    N: tl.constexpr, LIMIT: tl.constexpr, BLOCK: tl.constexpr,
+):
+    idx = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    row, col = idx // N, idx % N
+    valid = idx < elements
+    gate = tl.load(x + row * stride_x + col, valid, other=0).to(tl.float32)
+    up = tl.load(x + row * stride_x + N + col, valid, other=0).to(tl.float32)
+    # Comparisons preserve NaNs, matching torch.clamp.
+    gate = tl.where(gate > LIMIT, LIMIT, gate)
+    up = tl.where(up > LIMIT, LIMIT, up)
+    up = tl.where(up < -LIMIT, -LIMIT, up)
+    # [ax] 172: eager F.silu materializes BF16 BEFORE the final multiply.
+    # Keep that rounding boundary; a fully-FP32 expression changes the model.
+    activated = (gate / (1.0 + tl.exp(-gate))).to(x.dtype.element_ty).to(tl.float32)
+    tl.store(out + row * stride_out + col, activated * up, valid)
+
