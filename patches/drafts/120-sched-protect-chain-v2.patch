+
+        cap, short = _ax_sched_protect_config()
+        grid = math.lcm(self.page_size, self.truncation_align_size or 1)
+        if self.tree_cache.supports_mamba():
+            grid = math.lcm(grid, mamba_checkpoint_grid(self.tree_cache.page_size))
