#!/usr/bin/env bash
# Pod job queue controller (run on the GPU box).
#   podq init                 start the worker after the commit-based runtime was deployed
#   submit via local qpush   fixed commit + complete runtime + explicit run name
#   podq ls                   queue state + running job tail      podq log <job> [lines]
#   podq pause|resume         stop/start picking new jobs (does NOT stop the service)
#   podq cancel <job>         remove a pending job
set -euo pipefail
D=$(cd "$(dirname "$0")" && pwd); source "$D/common.sh"; REPO=$(cd "$D/../.." && pwd)
case "${1:-}" in
  init)
    cd "$REPO"
    "$D/ppush" $POD_AX/bin scripts/pod/podq_worker.sh
    bexec "test -f $POD_AX/runtime-deployment.json" || { echo "deploy the commit runtime with qpush first"; exit 2; }
    bexec "cd $POD_AX && if [ -f worker.pid ] && kill -0 \$(cat worker.pid) 2>/dev/null; then echo worker already running; else setsid nohup bash bin/scripts/pod/podq_worker.sh > worker.out 2>&1 < /dev/null & sleep 1; echo worker started; fi" ;;
  submit)
    echo 'Use local scripts/pod/qpush: exports G_COMMIT and deploys its runtime before enqueueing.'; exit 2 ;;
  ls) "$D/pstatus" ;;
  log) bexec "tail -${3:-40} $POD_AX/runs/$2/job.log; echo; echo exit_code=\$(cat $POD_AX/runs/$2/exit_code 2>/dev/null)" ;;
  pause) bexec "touch $POD_AX/queue/PAUSE && echo paused" ;;
  resume) bexec "rm -f $POD_AX/queue/PAUSE && echo resumed" ;;
  cancel) bexec "rm -v $POD_AX/queue/pending/$2*" ;;
  *) sed -n 2,9p "$0" ;;
esac
