#!/usr/bin/env bash
# Local: deploy selected commits + current runtime and queue the jobs.
# Requires an idle, paused queue. Leaves it paused; inspect then podq resume.
# Transfer/publish runs detached on the GPU box so SSH loss does not interrupt it.
set -euo pipefail
cd "$(dirname "$0")/../.."
[ "$#" -gt 0 ] || { echo 'qpush queue-name.sh=scripts/pod/jobs/file.sh ...'; exit 2; }
bash scripts/pod/verify/make_kit.sh >/dev/null
id="queue-$(date -u +%Y%m%dT%H%M%S)-$$"
bundle="build/queue/$id"
python3 -B scripts/pod/queue_bundle.py build "$bundle" "$@"
cat > "$bundle/deploy.sh" <<DEPLOY
set -euo pipefail
cd /sjtu/linhang/arena/repo
scripts/pod/ppush /tmp/ax/staging/$id $bundle
source scripts/pod/common.sh
bexec 'python3 /tmp/ax/staging/$id/$bundle/queue_bundle.py publish /tmp/ax/staging/$id/$bundle'
DEPLOY
tar cf - "$bundle" scripts/pod | GSSH_TIMEOUT=120 scripts/gssh 'tar xf - -C /sjtu/linhang/arena/repo'
scripts/gjob run "$id" "cd /sjtu/linhang/arena/repo && bash $bundle/deploy.sh"
echo "DEPLOYMENT_JOB=$id (check gjob tail; resume only after RUNTIME_DEPLOYED)"
