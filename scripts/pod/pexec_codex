#!/usr/bin/env bash
# Reviewer (Codex/Fable) command execution in the L2 pod — user-approved 2026-09-23 with a STRICT NO-STOP rule.
# Allowed: read anything; write ONLY under /tmp/ax/codex/; run own CPU-only analysis scripts (CUDA hidden).
# Forbidden (refused here): service lifecycle (bohr/trisol), killing any process
# (engine, queue worker), touching /tmp/ax/{queue,src,runs,patches,bin} for writes, podq, GPU use.
#   scripts/pod/pexec_codex '<command>'        (upload scripts first: scripts/pod/ppush /tmp/ax/codex <files>)
set -uo pipefail
c="${1:-}"; [ -n "$c" ] || { sed -n 2,6p "$0"; exit 1; }
deny='(bohr|trisol|inference|kill|pkill|killall|shutdown|reboot|halt|systemctl|podq|nvidia-smi +-r|--gpu-reset|flush_cache|start_profile|/generate|:30000|launch_server|sglang\.launch|(^|[;&| ])(rm|mv|cp|tee|dd|truncate|chmod|chown|ln)[^;&|]*/tmp/ax/(queue|src|runs|patches|bin|worker|engine)|>[^;&|]*/tmp/ax/(queue|src|runs|patches|bin|worker|engine))'
if echo "$c" | grep -qiE "$deny"; then echo "REFUSED by pexec_codex policy (no stop / no kill / no writes outside /tmp/ax/codex / no engine requests): $c" >&2; exit 3; fi
case "${PEXEC_TRANSPORT:-gpu}" in
  gpu)
    # Same route as pread: local -> gssh -> GPU box (its bohr login) -> pod. Sourcing common.sh here would run bohr with the
    # local container's login instead, which expires separately (2026-09-26: every window snapshot failed for hours this way).
    inner="mkdir -p /tmp/ax/codex && cd /tmp/ax/codex && export CUDA_VISIBLE_DEVICES='' && $c"
    if [ -d /sjtu/linhang/arena/repo ]; then
      # Already on the GPU box (fetch_level runs this script there over gssh): use its bohr login directly.
      D="$(cd "$(dirname "$0")" && pwd)"; source "$D/common.sh"
      PEXEC_TIMEOUT=${PEXEC_TIMEOUT:-600} bexec "$inner"
    else
      G="$(cd "$(dirname "$0")/../.." && pwd)/scripts/gssh"
      GSSH_TIMEOUT=$(( ${PEXEC_TIMEOUT:-600} + 60 )) "$G" "cd /sjtu/linhang/arena/repo && source scripts/pod/common.sh >/dev/null 2>&1 && PEXEC_TIMEOUT=${PEXEC_TIMEOUT:-600} bexec $(printf '%q' "$inner")"
    fi ;;
  local)
    timeout "${PEXEC_TIMEOUT:-600}" bohr trisol inference exec "${L2_SERVICE_ID:-2102486579267252224}" --team arena -- bash -c "mkdir -p /tmp/ax/codex && cd /tmp/ax/codex && export CUDA_VISIBLE_DEVICES='' && $c" ;;
  *) echo 'PEXEC_TRANSPORT must be gpu or local' >&2; exit 2 ;;
esac
