#!/usr/bin/env bash
# Rebuild the pod workspace on a fresh L2 service (run on the GPU box from the repo root):
# worker + lib + all numbered patches (podq init), dev set + harness, pod tools. Idempotent.
set -euo pipefail
D=$(cd "$(dirname "$0")" && pwd); source "$D/common.sh"; cd "$D/../.."
bexec "nvidia-smi --query-gpu=index,name,memory.used --format=csv,noheader | head -8; ls /mnt/models | head -3"
"$D/podq" init
S1SRC=s1-dev; [ -d $S1SRC/data ] || S1SRC=../s1-dev
( cd "$(dirname $S1SRC)" && PPUSH_PAR=12 "$D/ppush" $POD_AX/s1 "$(basename $S1SRC)/run_dev.py" "$(basename $S1SRC)/harness" "$(basename $S1SRC)/data" )
"$D/ppush" $POD_AX build/podtools
bash scripts/pod/verify/make_kit.sh >/dev/null && ( cd build && "$D/ppush" $POD_AX verify_kit )
bexec "ls $POD_AX/s1/s1-dev $POD_AX/patches; ls $POD_AX/queue"
