    for f in $(grep '^+++ b/' /tmp/ax/engine.diff | cut -d/ -f4- | grep '\.py$'); do python3 -S -I -m py_compile "$PKG/$f"; done; \
    python3 -c 'import hashlib,pathlib,sys; root=pathlib.Path(sys.argv[1]); paths=sorted(x.removeprefix("+++ b/engine/sglang/") for x in pathlib.Path(sys.argv[2]).read_text().splitlines() if x.startswith("+++ b/engine/sglang/")); h=hashlib.sha256(); [(h.update(p.encode()+bytes([0])),h.update((root/p).read_bytes()),h.update(bytes([0]))) for p in paths]; assert h.hexdigest()==sys.argv[3], "engine source digest mismatch"; print("ENGINE_SOURCE_VERIFIED",len(paths),h.hexdigest())' "$PKG" /tmp/ax/engine.diff 5f0191240ba1c0cc69382c782183a89ae6dea414315c73c9b141d7e704235334; \
    echo 20a58da99737c70f21c801ff587e94d8f54022be > /opt/ax/engine_commit; rm -rf /tmp/ax; \
    echo 'engine source applied'
